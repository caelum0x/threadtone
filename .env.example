# Wearday Plus (RevenueCat). See PAYWALL.md for full setup steps.
# These must be prefixed EXPO_PUBLIC_ to be inlined into the app bundle (Expo convention).

# Platform-specific RevenueCat public SDK keys (Project settings → API keys in the RevenueCat dashboard).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Entitlement identifier configured in RevenueCat (Entitlements tab). Defaults to "wearday_plus".
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=wearday_plus

# Product ids as registered in App Store Connect / Play Console AND attached to the
# RevenueCat offering's packages. Defaults shown match PAYWALL.md's suggested SKUs.
EXPO_PUBLIC_REVENUECAT_PLUS_MONTHLY_PRODUCT_ID=wearday_plus_monthly
EXPO_PUBLIC_REVENUECAT_PLUS_YEARLY_PRODUCT_ID=wearday_plus_yearly
